+    assert m.long.trades == 1 and m.long.losses == 1
+    assert m.short.trades == 1 and m.short.wins == 1
+    assert m.long.net_pnl == Decimal("-50")
+    assert m.short.net_pnl == Decimal("120")
+    assert m.trades == 2 and m.net_pnl == Decimal("70")
+
